# ─────────────────────────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────
# Atlassian — Jira & Confluence
# Uses the official Atlassian Rovo MCP server (GA Feb 2026)
# Docs: https://github.com/atlassian/atlassian-mcp-server
# ─────────────────────────────────────────────────────────────────
# Your Atlassian Cloud site URL (no trailing slash)
JIRA_URL=https://your-company.atlassian.net
# Your Atlassian account email
JIRA_USERNAME=your.email@company.com
# API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_atlassian_api_token_here

# Confluence shares the same credentials as Jira on Atlassian Cloud
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=your.email@company.com
CONFLUENCE_API_TOKEN=your_atlassian_api_token_here

# ─────────────────────────────────────────────────────────────────
# Zephyr Scale — Official SmartBear MCP
# Docs: https://developer.smartbear.com/smartbear-mcp/docs/zephyr-integration
# API token from: https://support.smartbear.com/zephyr/docs/en/rest-api/api-access-tokens-management.html
# ─────────────────────────────────────────────────────────────────
ZEPHYR_API_TOKEN=your_zephyr_api_token_here
# Default: https://api.zephyrscale.smartbear.com/v2
# Change for EU region: https://eu.api.zephyrscale.smartbear.com/v2
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2

# ─────────────────────────────────────────────────────────────────
# AWS Bedrock Knowledge Base
# Docs: https://docs.aws.amazon.com/bedrock/latest/userguide/knowledge-base.html
# ─────────────────────────────────────────────────────────────────
# AWS region where your Bedrock KB and S3 bucket are deployed
AWS_REGION=us-east-1
# S3 bucket that backs the Bedrock data source
KB_S3_BUCKET=your-company-test-kb-bucket
# Key prefix within the bucket (keeps KB docs organised)
KB_S3_PREFIX=kb-docs
# Knowledge Base ID — from AWS Console → Bedrock → Knowledge Bases
KB_KNOWLEDGE_BASE_ID=XXXXXXXXXX
# Data Source ID — the S3 data source linked to the KB
KB_DATA_SOURCE_ID=YYYYYYYYYY
# Optional: AWS named profile (leave blank to use default credential chain / IAM role)
AWS_PROFILE=

# ─────────────────────────────────────────────────────────────────
# TMA Knowledge Base — Duplicate Detection
# ─────────────────────────────────────────────────────────────────
# Cosine similarity >= this → auto-delete older entry from KB
KB_AUTO_DELETE_THRESHOLD=0.97
# Cosine similarity >= this (and < auto-delete) → flag older entry as outdated
KB_FLAG_THRESHOLD=0.90

# ─────────────────────────────────────────────────────────────────
# Agent Config
# ─────────────────────────────────────────────────────────────────
# Default Jira project key for test generation
DEFAULT_JIRA_PROJECT=YOUR_PROJECT_KEY
# Set to true to write approved test cases back to Zephyr automatically
AUTO_WRITE_TO_ZEPHYR=false
