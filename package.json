{
  "name": "atlassian-test-agent",
  "version": "1.0.0",
  "description": "Claude-powered test case generator — Jira · Confluence · Zephyr · Local UI",
  "type": "module",
  "scripts": {
    "ui": "tsx ui/server.ts & vite & wait",
    "ui:dev": "tsx watch ui/server.ts & vite & wait",
    "demo": "tsx demo/run-demo.ts",
    "demo:interactive": "tsx demo/run-demo.ts --interactive",
    "demo:ticket": "tsx demo/run-demo.ts --ticket",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test:unit": "npx tsx --test tests/unit/*.test.ts",
    "test:install": "npm install --save-dev @playwright/test && npx playwright install chromium",
    "test": "npm run test:unit",
    "test:functional-api": "npx playwright test --project=functional-api",
    "test:functional-ui": "npx playwright test --project=functional-ui",
    "test:integration": "npx playwright test --project=integration",
    "test:all": "npm run test:unit && npx playwright test",
    "test:report": "npx playwright show-report tests/reports",
    "ui:server": "tsx ui/server.ts",
    "ui:client": "vite",
    "ui:build": "vite build",
    "ui:prod": "tsx ui/server.ts",
    "test:unit:watch": "npx tsx --test --watch tests/unit/*.test.ts",
    "test:unit:verbose": "npx tsx --test tests/unit/*.test.ts",
    "kb:migrate": "tsx src/kb/migrate.ts",
    "kb:schema": "echo \"Apply src/kb/schema.sql to your PostgreSQL database\"",
    "kb": "node tma/scanner/manage.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0",
    "ws": "^8.17.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@inquirer/prompts": "^7.10.1",
    "openai": "^4.52.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
